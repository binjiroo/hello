        {
            "name": "Python デバッガー: 現在のファイル",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",

            // ↓ ここを追加 ↓
            // Ctrl+Shift+P → Python: Select Interpreter で選んだものが反映されます
            "python": "${command:python.interpreterPath}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Current File",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}